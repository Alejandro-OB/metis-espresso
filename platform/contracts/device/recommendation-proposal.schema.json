{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eko.local/contracts/v1/recommendation-proposal.schema.json",
  "title": "Evidence-backed recommendation proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recommendationId", "inferenceId", "status", "reasonCode", "summary", "proposedAdjustment", "uncertainty", "evidenceIds", "applicability", "requiresHumanReview", "actuatorCommand"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recommendationId": {"type": "string", "minLength": 1, "maxLength": 80},
    "inferenceId": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"enum": ["abstained", "test-only", "pending-human-review"]},
    "reasonCode": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "proposedAdjustment": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["property", "direction", "value", "unit"],
          "properties": {
            "property": {"type": "string", "minLength": 1},
            "direction": {"enum": ["increase", "decrease", "maintain"]},
            "value": {"type": ["number", "null"]},
            "unit": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "methodReference"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "methodReference": {"type": "string", "format": "uri"}
      }
    },
    "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "applicability": {"type": "string", "minLength": 1, "maxLength": 1000},
    "requiresHumanReview": {"type": "boolean"},
    "actuatorCommand": {"type": "null"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "abstained"}}},
      "then": {
        "properties": {
          "proposedAdjustment": {"type": "null"},
          "requiresHumanReview": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pending-human-review"}}},
      "then": {
        "properties": {
          "proposedAdjustment": {"type": "object"},
          "requiresHumanReview": {"const": true}
        }
      }
    }
  ]
}
