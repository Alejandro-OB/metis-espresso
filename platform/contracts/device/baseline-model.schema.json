{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eko.local/contracts/v1/baseline-model.schema.json",
  "title": "Software-validation baseline model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "modelType", "status", "purpose", "task", "createdAt", "datasetId", "datasetSha256", "trainingConfig", "prediction", "labelCounts", "empiricalFrequency", "metrics", "applicability", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "modelId": {"type": "string", "minLength": 1},
    "modelType": {"const": "most-frequent-baseline-v1"},
    "status": {"const": "candidate"},
    "purpose": {"const": "software-validation-only"},
    "task": {"const": "adjustment-outcome-category"},
    "createdAt": {"type": "string", "format": "date-time"},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trainingConfig": {"type": "object"},
    "prediction": {"enum": ["expected-observed", "insufficient-observed", "adverse-observed", "inconclusive"]},
    "labelCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "empiricalFrequency": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heldOutAccuracy", "evaluationStatus", "trainRecordCount", "testRecordCount"],
      "properties": {
        "heldOutAccuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evaluationStatus": {"enum": ["evaluated", "insufficient-independent-groups"]},
        "trainRecordCount": {"type": "integer", "minimum": 1},
        "testRecordCount": {"type": "integer", "minimum": 0}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coveredCoffeeIds", "heldOutCoffeeIds", "dataOrigin", "useStatus"],
      "properties": {
        "coveredCoffeeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "heldOutCoffeeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "dataOrigin": {"enum": ["measured", "simulation", "mixed"]},
        "useStatus": {"const": "test-only"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
