{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eko.local/contracts/v1/sensory-evaluation.schema.json",
  "title": "Observed sensory evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "evaluatedBy", "evaluatedAt", "scores"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 80},
    "evaluatedBy": {"type": "string", "minLength": 1, "maxLength": 120},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "protocolReference": {"type": ["string", "null"], "maxLength": 500},
    "descriptors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "defects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attribute", "dimension", "value"],
        "properties": {
          "attribute": {"type": "string", "minLength": 1, "maxLength": 80},
          "dimension": {"enum": ["perceived-intensity", "hedonic-liking"]},
          "value": {"type": "integer"}
        },
        "allOf": [
          {
            "if": {"properties": {"dimension": {"const": "perceived-intensity"}}},
            "then": {"properties": {"value": {"minimum": 0, "maximum": 10}}}
          },
          {
            "if": {"properties": {"dimension": {"const": "hedonic-liking"}}},
            "then": {"properties": {"value": {"minimum": 1, "maximum": 9}}}
          },
          {
            "if": {"properties": {"attribute": {"enum": ["balance", "overall-liking"]}}},
            "then": {"properties": {"dimension": {"const": "hedonic-liking"}}}
          }
        ]
      }
    },
    "acceptance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["accepted", "rejected", "inconclusive"]},
            "rationale": {"type": ["string", "null"], "maxLength": 2000}
          },
          "if": {"properties": {"status": {"const": "rejected"}}},
          "then": {
            "required": ["rationale"],
            "properties": {"rationale": {"type": "string", "minLength": 1, "maxLength": 2000}}
          }
        }
      ]
    },
    "comment": {"type": ["string", "null"], "maxLength": 4000}
  }
}
