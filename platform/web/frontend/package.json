{
  "name": "aplicacion-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "typecheck": "tsc -b",
    "lint": "npm run typecheck && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:a11y": "vitest run src/shared/ui",
    "e2e": "playwright test",
    "e2e:compose": "node e2e/proxy.mjs & playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:api": "openapi-typescript http://localhost:8000/api/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hookform/resolvers": "5.2.1",
    "@tanstack/react-query": "5.85.5",
    "react": "19.1.1",
    "react-aria-components": "1.12.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "storybook": "9.1.20",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
