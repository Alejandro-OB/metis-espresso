#################################################################
# Caso 4: un ajuste pequeño de temperatura no corrige la acidez y uno mayor sí
#################################################################
# Las tres extracciones quedan dentro del perfil en todas las variables
# técnicas; solo cambia la temperatura del agua (92,0 → 92,5 → 93,5 °C).
# El resultado se juzga por la evaluación sensorial del barista.

edt:C4Dose1 a edt:CoffeeDose .
edt:C4Dose2 a edt:CoffeeDose .
edt:C4Dose3 a edt:CoffeeDose .
edt:C4Beverage1 a edt:EspressoBeverage .
edt:C4Beverage2 a edt:EspressoBeverage .
edt:C4Beverage3 a edt:EspressoBeverage .
edt:C4TempSeries1 a edt:ObservationSeries ; edt:seriesForProperty edt:WaterTemperature ; edt:hasUnit edt:DegreeCelsius ; edt:dataReference "urn:series:c4:1:temperature"^^xsd:anyURI .
edt:C4TempSeries2 a edt:ObservationSeries ; edt:seriesForProperty edt:WaterTemperature ; edt:hasUnit edt:DegreeCelsius ; edt:dataReference "urn:series:c4:2:temperature"^^xsd:anyURI .
edt:C4TempSeries3 a edt:ObservationSeries ; edt:seriesForProperty edt:WaterTemperature ; edt:hasUnit edt:DegreeCelsius ; edt:dataReference "urn:series:c4:3:temperature"^^xsd:anyURI .
edt:C4Extraction1 a edt:EspressoExtraction ; edt:performedBy edt:BaristaA ; edt:usesProfile edt:perfil_001 ; edt:usesMaterial edt:CoffeeLotA, edt:C4Dose1 ; edt:usesEquipment edt:MachineValidation, edt:GrinderValidation ; edt:producesBeverage edt:C4Beverage1 ; edt:occurredUnder edt:EnvC4 ; edt:hasObservationSeries edt:C4TempSeries1 ; edt:startTime "2026-09-03T09:00:00-05:00"^^xsd:dateTime ; edt:endTime "2026-09-03T09:00:27-05:00"^^xsd:dateTime ; edt:hasObservation edt:C4DoseObs1, edt:C4MassObs1, edt:C4TimeObs1, edt:C4TempObs1, edt:C4PressureObs1, edt:C4ThermalObs1 ; edt:hasSensoryEvaluation edt:C4Sensory1 ; edt:precedes edt:C4Adjustment .
edt:C4Adjustment a edt:ManualParameterAdjustment ; edt:performedBy edt:BaristaA ; edt:changesProperty edt:WaterTemperature ; edt:targetsOutcome edt:ExcessiveAcidity ; edt:previousNumericValue 92.0 ; edt:newNumericValue 92.5 ; edt:hasUnit edt:DegreeCelsius ; edt:startTime "2026-09-03T09:03:00-05:00"^^xsd:dateTime ; edt:endTime "2026-09-03T09:03:10-05:00"^^xsd:dateTime ; edt:precedes edt:C4Extraction2 .
