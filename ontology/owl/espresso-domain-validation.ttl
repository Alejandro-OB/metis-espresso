@prefix edt: <https://w3id.org/espresso-dt#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Población sintética de entrada para los casos 1, 2, 4, 7, 9 y 11 a 17.
# Contiene hechos observados, perfiles, contextos y decisiones registradas.
# Las desviaciones, los diagnósticos, las diferencias y las explicaciones son materializados por el
# razonador externo; no se almacenan aquí como respuestas predeterminadas.

#################################################################
# Entidades comunes y perfil
#################################################################

edt:BaristaA a edt:Barista ; rdfs:label "barista A"@es .
edt:BaristaB a edt:Barista ; rdfs:label "barista B"@es .
edt:CoffeeSourceA a edt:Agent ; rdfs:label "fuente comercial sintética A"@es .
edt:MachineValidation a edt:EspressoMachine ; rdfs:label "máquina de validación"@es .
edt:GrinderValidation a edt:Grinder ; rdfs:label "molino de validación"@es .

edt:CoffeeLotA a edt:CoffeeMaterial ;
    rdfs:label "lote de café A"@es ;
    edt:lotIdentifier "LOT-A-2026" ;
    edt:bagIdentifier "BAG-A-01" ;
    edt:commercialReference "Referencia sintética A" ;
    edt:roastDate "2026-08-25T00:00:00-05:00"^^xsd:dateTime ;
    edt:hasVariety edt:Caturra ;
    edt:hasPostHarvestProcess edt:Washed ;
    edt:hasRoastLevel edt:MediumRoast ;
    edt:hasTerroir edt:TerroirCoffeeLotA ;
    edt:hasDeclaredSensoryProfile edt:DeclaredProfileCoffeeLotA .

edt:DeclaredProfileCoffeeLotA a edt:DeclaredSensoryProfile ;
    edt:describesCoffee edt:CoffeeLotA ;
    edt:declaredBy edt:CoffeeSourceA ;
    edt:hasSensoryDescriptor edt:Chocolate, edt:Caramel, edt:Citrus ;
    edt:sensoryDescriptionText "Chocolate, caramelo y cítrico"@es ;
    dcterms:source <urn:source:coffee-lot-a-sheet> .

edt:TargetProfileCoffeeLotA a edt:TargetSensoryProfile ;
    edt:describesCoffee edt:CoffeeLotA ;
    edt:sensoryTargetDefinedBy edt:BaristaA ;
    edt:hasSensoryDescriptor edt:Chocolate, edt:Caramel ;
    dcterms:source "Objetivo sintético de validación definido por el barista A"@es .

edt:TerroirCoffeeLotA a edt:Terroir ;
    rdfs:label "terroir del lote A"@es ;
    edt:regionName "Huila, Colombia" ;
    edt:hasAltitude edt:AltitudeCoffeeLotA ;
    edt:soilCharacteristics "suelo volcánico" ;
    edt:mineralComposition "composición mineral sintética declarada" ;
    dcterms:source <urn:source:coffee-lot-a-sheet> .

edt:AltitudeCoffeeLotA a edt:AltitudeSpecification ; edt:quantityValue 1800.0 ; edt:hasUnit edt:Meter .

edt:perfil_001 a edt:ExtractionProfile ;
    rdfs:label "perfil_001"@es ;
    edt:definedBy edt:BaristaA ;
    edt:validatedBy edt:BaristaA ;
    edt:applicableToCoffee edt:CoffeeLotA ;
    edt:hasTargetSensoryProfile edt:TargetProfileCoffeeLotA ;
    edt:hasProfileStatus edt:Approved ;
    edt:supportedBy edt:C2ExtractionA ;
    edt:hasParameterSpecification edt:SpecDose, edt:SpecBeverageMass, edt:SpecTime,
        edt:SpecTemperature, edt:SpecPressure, edt:SpecThermalStability,
        edt:SpecTDS, edt:SpecYield .

edt:SpecDose a edt:ProfileParameterSpecification ; edt:forProperty edt:CoffeeDoseMass ; edt:targetValue 18.0 ; edt:toleranceValue 0.2 ; edt:hasUnit edt:Gram .
edt:SpecBeverageMass a edt:ProfileParameterSpecification ; edt:forProperty edt:BeverageMass ; edt:targetValue 36.0 ; edt:toleranceValue 1.0 ; edt:hasUnit edt:Gram .
edt:SpecTime a edt:ProfileParameterSpecification ; edt:forProperty edt:ExtractionTime ; edt:minimumValue 25.0 ; edt:maximumValue 30.0 ; edt:hasUnit edt:Second .
edt:SpecTemperature a edt:ProfileParameterSpecification ; edt:forProperty edt:WaterTemperature ; edt:minimumValue 92.0 ; edt:maximumValue 94.0 ; edt:hasUnit edt:DegreeCelsius .
edt:SpecPressure a edt:ProfileParameterSpecification ; edt:forProperty edt:ExtractionPressure ; edt:targetValue 9.0 ; edt:toleranceValue 0.5 ; edt:hasUnit edt:Bar .
edt:SpecThermalStability a edt:ProfileParameterSpecification ; edt:forProperty edt:ThermalStability ; edt:minimumValue 0.0 ; edt:maximumValue 0.7 ; edt:hasUnit edt:DegreeCelsius .
edt:SpecTDS a edt:ProfileParameterSpecification ; edt:forProperty edt:TDS ; edt:minimumValue 8.0 ; edt:maximumValue 12.0 ; edt:hasUnit edt:Percent .
edt:SpecYield a edt:ProfileParameterSpecification ; edt:forProperty edt:ExtractionYield ; edt:minimumValue 19.0 ; edt:maximumValue 24.0 ; edt:hasUnit edt:Percent .

#################################################################
# Condiciones ambientales
#################################################################

edt:EnvC1 a edt:EnvironmentalCondition ; edt:validFrom "2026-09-01T08:00:00-05:00"^^xsd:dateTime ; edt:validUntil "2026-09-01T10:00:00-05:00"^^xsd:dateTime .
edt:EnvC2 a edt:EnvironmentalCondition ; edt:validFrom "2026-09-02T08:00:00-05:00"^^xsd:dateTime ; edt:validUntil "2026-09-02T10:00:00-05:00"^^xsd:dateTime .
edt:EnvC4 a edt:EnvironmentalCondition ; edt:validFrom "2026-09-03T08:00:00-05:00"^^xsd:dateTime ; edt:validUntil "2026-09-03T10:00:00-05:00"^^xsd:dateTime .
edt:EnvC7 a edt:EnvironmentalCondition ; edt:validFrom "2026-09-04T08:00:00-05:00"^^xsd:dateTime ; edt:validUntil "2026-09-04T10:00:00-05:00"^^xsd:dateTime .
edt:EnvC9 a edt:EnvironmentalCondition ; edt:validFrom "2026-09-06T08:00:00-05:00"^^xsd:dateTime ; edt:validUntil "2026-09-06T10:00:00-05:00"^^xsd:dateTime .

#################################################################
# Caso 1: astringencia y desviaciones respecto al perfil
#################################################################

edt:C1Dose a edt:CoffeeDose ; edt:hasVariety edt:Caturra ; edt:hasPostHarvestProcess edt:Washed ; edt:hasRoastLevel edt:MediumRoast ; edt:hasGrindCoarsenessCategory edt:Fine .
edt:C1Beverage a edt:EspressoBeverage .
edt:C1TemperatureSeries a edt:ObservationSeries ; edt:seriesForProperty edt:WaterTemperature ; edt:hasUnit edt:DegreeCelsius ; edt:dataReference "urn:series:c1:temperature"^^xsd:anyURI .
edt:C1Extraction a edt:EspressoExtraction ;
    edt:performedBy edt:BaristaA ; edt:usesProfile edt:perfil_001 ;
    edt:usesMaterial edt:CoffeeLotA, edt:C1Dose ;
    edt:usesEquipment edt:MachineValidation, edt:GrinderValidation ;
    edt:producesBeverage edt:C1Beverage ; edt:occurredUnder edt:EnvC1 ;
    edt:hasObservationSeries edt:C1TemperatureSeries ;
    edt:startTime "2026-09-01T09:00:00-05:00"^^xsd:dateTime ; edt:endTime "2026-09-01T09:00:35-05:00"^^xsd:dateTime ;
    edt:hasObservation edt:C1DoseObs, edt:C1MassObs, edt:C1TimeObs, edt:C1TempObs,
        edt:C1PressureObs, edt:C1ThermalObs, edt:C1TDSObs, edt:C1YieldObs ;
    edt:hasSensoryEvaluation edt:C1Sensory .
edt:C1DoseObs a edt:MeasuredObservation ; edt:observedProperty edt:CoffeeDoseMass ; edt:featureOfInterest edt:C1Dose ; edt:numericValue 18.0 ; edt:hasUnit edt:Gram ; edt:resultTime "2026-09-01T09:00:00-05:00"^^xsd:dateTime .
edt:C1MassObs a edt:MeasuredObservation ; edt:observedProperty edt:BeverageMass ; edt:featureOfInterest edt:C1Beverage ; edt:numericValue 36.0 ; edt:hasUnit edt:Gram ; edt:resultTime "2026-09-01T09:00:35-05:00"^^xsd:dateTime .
edt:C1TimeObs a edt:MeasuredObservation ; edt:observedProperty edt:ExtractionTime ; edt:featureOfInterest edt:C1Extraction ; edt:numericValue 35.0 ; edt:hasUnit edt:Second ; edt:resultTime "2026-09-01T09:00:35-05:00"^^xsd:dateTime .
edt:C1TempObs a edt:MeasuredObservation ; edt:observedProperty edt:WaterTemperature ; edt:featureOfInterest edt:C1Extraction ; edt:numericValue 93.0 ; edt:hasUnit edt:DegreeCelsius ; edt:resultTime "2026-09-01T09:00:20-05:00"^^xsd:dateTime .
edt:C1PressureObs a edt:MeasuredObservation ; edt:observedProperty edt:ExtractionPressure ; edt:featureOfInterest edt:C1Extraction ; edt:numericValue 9.0 ; edt:hasUnit edt:Bar ; edt:resultTime "2026-09-01T09:00:20-05:00"^^xsd:dateTime .
edt:C1ThermalObs a edt:CalculatedObservation, edt:QualityIndicatorObservation ; edt:observedProperty edt:ThermalStability ; edt:featureOfInterest edt:C1Extraction ; edt:numericValue 0.4 ; edt:hasUnit edt:DegreeCelsius ; edt:resultTime "2026-09-01T09:00:35-05:00"^^xsd:dateTime ; edt:derivedFromSeries edt:C1TemperatureSeries ; edt:calculationMethodReference "urn:method:thermal-stability:2sd-error"^^xsd:anyURI .
edt:C1TDSObs a edt:TDSObservation ; edt:observedProperty edt:TDS ; edt:featureOfInterest edt:C1Beverage ; edt:numericValue 10.5 ; edt:hasUnit edt:Percent ; edt:resultTime "2026-09-01T09:02:00-05:00"^^xsd:dateTime .
edt:C1YieldObs a edt:ExtractionYieldObservation ; edt:observedProperty edt:ExtractionYield ; edt:featureOfInterest edt:C1Extraction ; edt:numericValue 21.0 ; edt:hasUnit edt:Percent ; edt:resultTime "2026-09-01T09:02:01-05:00"^^xsd:dateTime ; edt:computedFrom edt:C1DoseObs, edt:C1MassObs, edt:C1TDSObs ; edt:calculationMethodReference "urn:method:extraction-yield:tds-beverage-dose"^^xsd:anyURI .
edt:C1Sensory a edt:SensoryEvaluation ; edt:evaluatedBy edt:BaristaA ; edt:evaluatesBeverage edt:C1Beverage ; edt:evaluationTime "2026-09-01T09:03:00-05:00"^^xsd:dateTime ; edt:hasPerceivedDefect edt:ExcessiveAstringency ; edt:hasSensoryScore edt:C1AstringencyIntensity, edt:C1AstringencyLiking .
edt:C1AstringencyIntensity a edt:PerceivedIntensityScore ; edt:forSensoryAttribute edt:Astringency ; edt:measuresDimension edt:PerceivedIntensity ; edt:scoreValue 8 .
edt:C1AstringencyLiking a edt:HedonicLikingScore ; edt:forSensoryAttribute edt:Astringency ; edt:measuresDimension edt:HedonicLiking ; edt:scoreValue 3 .

