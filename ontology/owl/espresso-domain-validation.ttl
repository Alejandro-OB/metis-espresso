#################################################################
# Receta de ejemplo para los casos 11 a 16 (EKO 3.4.0)
#################################################################
# Es un ejemplo declarado como tal: la conclusión de cada caso depende solo de
# quedar dentro o fuera de la receta, no de estos valores. En la máquina se usa
# la receta real del barista. La caldera se juzga contra la referencia que se
# deriva del agua (acta v6), como en las preparaciones medidas.

edt:perfil_receta_ejemplo a edt:ExtractionProfile ;
    rdfs:label "receta de ejemplo"@es ;
    edt:definedBy edt:BaristaA ;
    edt:validatedBy edt:BaristaA ;
    edt:applicableToCoffee edt:CoffeeLotA ;
    edt:hasProfileStatus edt:Approved ;
    edt:hasParameterSpecification edt:RecipeSpecDose, edt:RecipeSpecMass, edt:RecipeSpecTime,
        edt:RecipeSpecWater, edt:RecipeSpecBoiler, edt:RecipeSpecTDS .
edt:RecipeSpecDose a edt:ProfileParameterSpecification ; edt:forProperty edt:CoffeeDoseMass ; edt:targetValue 13.0 ; edt:toleranceValue 0.5 ; edt:hasUnit edt:Gram .
edt:RecipeSpecMass a edt:ProfileParameterSpecification ; edt:forProperty edt:BeverageMass ; edt:targetValue 30.0 ; edt:toleranceValue 2.0 ; edt:hasUnit edt:Gram .
edt:RecipeSpecTime a edt:ProfileParameterSpecification ; edt:forProperty edt:ExtractionTime ; edt:minimumValue 18.0 ; edt:maximumValue 22.0 ; edt:hasUnit edt:Second .
edt:RecipeSpecWater a edt:ProfileParameterSpecification ; edt:forProperty edt:WaterTemperature ; edt:targetValue 92.0 ; edt:toleranceValue 1.0 ; edt:hasUnit edt:DegreeCelsius .
edt:RecipeSpecBoiler a edt:ProfileParameterSpecification ; edt:forProperty edt:BoilerBodyTemperature ; edt:targetValue 101.9 ; edt:toleranceValue 1.24 ; edt:hasUnit edt:DegreeCelsius ; edt:derivedFromSpecification edt:RecipeSpecWater .
edt:RecipeSpecTDS a edt:ProfileParameterSpecification ; edt:forProperty edt:TDS ; edt:targetValue 9.0 ; edt:toleranceValue 0.6 ; edt:hasUnit edt:Percent .

