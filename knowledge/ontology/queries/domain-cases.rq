PREFIX edt: <https://w3id.org/espresso-dt#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?barista ?profile ?extraction ?diagnosis ?conclusion ?explanation ?recommendation ?direction ?source WHERE {
  ?extraction a edt:EspressoExtraction ; edt:performedBy ?barista ; edt:usesProfile ?profile ;
    edt:hasRecommendedAction ?action .
  ?action edt:supportedByHeuristic edt:HighDoseTasteHeuristic ; edt:respondsTo ?diagnosis ;
    edt:description ?recommendation ; edt:recommendedDirection ?direction .
  ?diagnosis a edt:Diagnosis ; edt:supportedByHeuristic edt:HighDoseTasteHeuristic ;
    edt:description ?conclusion ; edt:generatedBy edt:EvidenceBasedReasoner .
  ?explanationNode edt:explains ?diagnosis ; edt:description ?explanation .
  edt:HighDoseTasteHeuristic dcterms:source ?source .
}

# --- CASE15 ---
# ¿Qué conviene cambiar primero en un café amargo y largo?
PREFIX edt: <https://w3id.org/espresso-dt#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?barista ?profile ?extraction ?diagnosis ?conclusion ?explanation ?recommendation ?direction ?source WHERE {
  ?extraction a edt:EspressoExtraction ; edt:performedBy ?barista ; edt:usesProfile ?profile ;
    edt:hasRecommendedAction ?action ;
    edt:hasSensoryEvaluation/edt:hasPerceivedDefect edt:ExcessiveBitterness .
  ?action edt:supportedByHeuristic edt:LongBitterShotHeuristic ; edt:respondsTo ?diagnosis ;
    edt:description ?recommendation ; edt:recommendedDirection ?direction .
  ?diagnosis a edt:Diagnosis ; edt:supportedByHeuristic edt:LongBitterShotHeuristic ;
    edt:description ?conclusion ; edt:generatedBy edt:EvidenceBasedReasoner .
  ?explanationNode edt:explains ?diagnosis ; edt:description ?explanation .
  edt:LongBitterShotHeuristic dcterms:source ?source .
}

# --- CASE16 ---
# ¿Se atribuye una diferencia que cabe en la dispersión de la receta?
PREFIX edt: <https://w3id.org/espresso-dt#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?barista ?profile ?extraction ?diagnosis ?conclusion ?explanation ?recommendation ?direction ?source WHERE {
  ?extraction a edt:EspressoExtraction ; edt:performedBy ?barista ; edt:usesProfile ?profile ;
    edt:hasRecommendedAction ?action .
  ?action edt:supportedByHeuristic edt:WithinDispersionHeuristic ; edt:respondsTo ?diagnosis ;
    edt:description ?recommendation ; edt:recommendedDirection ?direction .
  ?diagnosis a edt:Diagnosis ; edt:supportedByHeuristic edt:WithinDispersionHeuristic ;
    edt:description ?conclusion ; edt:generatedBy edt:EvidenceBasedReasoner .
  ?explanationNode edt:explains ?diagnosis ; edt:description ?explanation .
  edt:WithinDispersionHeuristic dcterms:source ?source .
}

# --- CASE17 ---
# ¿Por qué se aceptó una bebida técnicamente no conforme, y qué concluye el razonador sobre ella?
PREFIX edt: <https://w3id.org/espresso-dt#>
SELECT ?barista ?extraction ?property ?value ?technicalStatus ?rationale ?diagnosis ?conclusion ?explanation WHERE {
  ?extraction a edt:EspressoExtraction ; edt:performedBy ?barista ;
    edt:hasSensoryEvaluation ?evaluation ; edt:hasObservation ?observation .
  ?evaluation edt:hasSensoryAcceptanceStatus edt:SensoryAccepted ; edt:acceptanceRationale ?rationale .
  FILTER NOT EXISTS { ?evaluation edt:hasPerceivedDefect ?anyDefect }
  ?assessment edt:assessesExtraction ?extraction ; edt:hasTechnicalConformance ?technicalStatus .
  FILTER (?technicalStatus = edt:TechnicallyNonConformant)
  ?deviation a edt:TechnicalDeviation ; edt:derivedFrom ?observation .
  ?observation edt:observedProperty ?property ; edt:numericValue ?value .
  ?diagnosis a edt:Diagnosis ; edt:derivedFrom ?deviation ; edt:description ?conclusion .
  FILTER NOT EXISTS { ?diagnosis edt:isDiagnosisOf ?defect . ?anyEvaluation edt:hasPerceivedDefect ?defect }
  ?explanationNode edt:explains ?diagnosis ; edt:description ?explanation .
}
