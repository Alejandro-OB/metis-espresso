@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edt: <https://w3id.org/espresso-dt#> .
@prefix esim: <https://w3id.org/espresso-dt/simulation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/espresso-dt/simulation> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/espresso-dt/simulation/1.1.4> ;
    owl:versionInfo "1.1.4" ;
    owl:imports <https://w3id.org/espresso-dt/3.5.0> ;
    dcterms:title "Módulo de simulación de EKO"@es ;
    dcterms:description "Procedencia y resultados de ejecuciones FMI sin autoridad física."@es .

esim:SimulationRun a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "ejecución de simulación"@es .

esim:VirtualExtraction a owl:Class ;
    rdfs:subClassOf edt:ProcessEntity, prov:Entity ;
    owl:disjointWith edt:EspressoExtraction ;
    rdfs:label "extracción virtual"@es .

esim:FmuModelArtifact a owl:Class ;
    rdfs:subClassOf edt:InformationEntity, prov:Entity ;
    rdfs:label "artefacto de modelo FMU"@es .

esim:SimulationScenario a owl:Class ;
    rdfs:subClassOf edt:InformationEntity, prov:Entity ;
    rdfs:label "escenario de simulación"@es .

esim:SimulationSeries a owl:Class ;
    rdfs:subClassOf edt:ObservationSeries, prov:Entity ;
    rdfs:label "serie simulada"@es .

esim:SimulatedObservation a owl:Class ;
    rdfs:subClassOf edt:QuantitativeObservation, prov:Entity ;
    owl:disjointWith edt:MeasuredObservation ;
    rdfs:label "observación simulada"@es .

esim:SimulationExecutor a owl:Class ;
    rdfs:subClassOf edt:SoftwareAgent, prov:SoftwareAgent ;
    rdfs:label "ejecutor de simulación"@es .

esim:usedModel a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain esim:SimulationRun ;
    rdfs:range esim:FmuModelArtifact .

esim:usedScenario a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain esim:SimulationRun ;
    rdfs:range esim:SimulationScenario .

esim:simulatesProfile a owl:ObjectProperty ;
    rdfs:domain esim:VirtualExtraction ;
    rdfs:range edt:ExtractionProfile .

esim:generatedVirtualExtraction a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain esim:SimulationRun ;
    rdfs:range esim:VirtualExtraction .

esim:hasSimulationSeries a owl:ObjectProperty ;
    rdfs:domain esim:VirtualExtraction ;
    rdfs:range esim:SimulationSeries .

esim:canBeComparedWith a owl:ObjectProperty ;
    rdfs:domain esim:VirtualExtraction ;
    rdfs:range edt:EspressoExtraction .

esim:modelId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:modelVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:sha256 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:contractVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:profileId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:profileVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer .
esim:durationSeconds a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .
esim:controllerId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:controllerVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:sampleCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer .
esim:mediaType a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:semanticSchemaVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .

# ── Comparación físico-virtual (1.1.0) ──
# La diferencia entre una preparación y su réplica simulada necesita términos
# propios: edt:ObservedDifference exige dos extracciones reales y esim:VirtualExtraction
# es disjunta de edt:EspressoExtraction, de modo que reutilizarla rompería la
# separación entre lo medido y lo simulado.

esim:PhysicalVirtualComparison a owl:Class ;
    rdfs:subClassOf edt:InformationEntity, prov:Entity ;
    rdfs:label "comparación físico-virtual"@es ;
    skos:definition "Contraste trazable entre las observaciones de una preparación y las de su réplica simulada, con su cobertura y su procedencia. No afirma causa ni autoriza actuación."@es .

esim:ChannelDifference a owl:Class ;
    rdfs:subClassOf edt:InformationEntity ;
    rdfs:label "diferencia por canal"@es ;
    skos:definition "Resumen de la diferencia observada en una propiedad entre la preparación medida y su réplica simulada."@es .

esim:comparesVirtualExtraction a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain esim:PhysicalVirtualComparison ;
    rdfs:range esim:VirtualExtraction ;
    rdfs:label "compara la extracción virtual"@es .

esim:comparesMeasuredExtraction a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain esim:PhysicalVirtualComparison ;
    rdfs:range edt:EspressoExtraction ;
    rdfs:label "compara la extracción medida"@es .

esim:hasChannelDifference a owl:ObjectProperty ;
    rdfs:domain esim:PhysicalVirtualComparison ;
    rdfs:range esim:ChannelDifference ;
    rdfs:label "tiene diferencia por canal"@es .

esim:meanSignedDifference a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal ;
    rdfs:label "diferencia media con signo"@es ;
    skos:definition "Media de simulado menos medido; un valor positivo indica que el modelo predice por encima de lo observado."@es .
esim:meanAbsoluteDifference a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .
esim:rootMeanSquareDifference a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .
esim:maxAbsoluteDifference a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .
esim:comparedSampleCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer .
esim:coverageRatio a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal ;
    skos:definition "Fracción de muestras medidas que pudo compararse; las ausentes no se imputan."@es .
esim:modelTolerance a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .
esim:comparisonVerdict a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string .
esim:modelLimitation a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    skos:definition "Limitación declarada del modelo para este canal; su presencia excluye la diferencia del veredicto."@es .
