    edt:dataReference "urn:series:demo:pressure"^^xsd:anyURI .

edt:CalibrationDemo01 a edt:EspressoCalibration ;
    rdfs:label "calibración de espresso de demostración"@es ;
    edt:performedBy edt:BaristaDemo ;
    edt:usesProfile edt:ProfileDemo01 ;
    edt:occurredUnder edt:EnvironmentalConditionDemo ;
    edt:hasTrialExtraction edt:ExtractionDemo01, edt:ExtractionDemo02 ;
    edt:hasParameterAdjustment edt:AdjustmentTimeDuringCalibrationDemo ;
    edt:validatesProfile edt:ProfileDemo01 ;
    edt:hasValidationStatus edt:Accepted ;
    edt:validatedBy edt:BaristaDemo ;
    edt:startTime "2026-08-05T09:55:00-05:00"^^xsd:dateTime ;
    edt:endTime "2026-08-05T10:03:00-05:00"^^xsd:dateTime .

edt:AdjustmentTimeDuringCalibrationDemo a edt:ManualParameterAdjustment ;
    rdfs:label "ajuste manual del tiempo dentro de calibración"@es ;
    edt:performedBy edt:BaristaDemo ;
    edt:changesProperty edt:ExtractionTime ;
    edt:targetsOutcome edt:ExtractionTime ;
    edt:partOfCalibration edt:CalibrationDemo01 ;
    edt:basedOnRecommendation edt:ActionShorterTimeDemo ;
    edt:startTime "2026-08-05T10:02:10-05:00"^^xsd:dateTime ;
