    edt:validFrom "2026-08-05T09:45:00-05:00"^^xsd:dateTime ;
    edt:validUntil "2026-08-05T11:30:00-05:00"^^xsd:dateTime ;
    edt:textValue "Condición ambiental sintética; la clasificación climática pertenece al código." .
edt:ObsAmbientTemperatureDemo a edt:QuantitativeObservation ;
    edt:observedProperty edt:AmbientTemperature ;
    edt:featureOfInterest edt:EnvironmentalConditionDemo ;
    edt:numericValue 24.0 ;
    edt:hasUnit edt:DegreeCelsius ;
