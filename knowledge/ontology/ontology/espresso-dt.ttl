edt:ProfileConformanceCriterion a edt:EvaluationCriterion ;
    rdfs:label "comparar observación con especificación del perfil"@es ;
    dcterms:source "docs/04-formalizacion.md"@es ;
    edt:description "Si una observación queda fuera del intervalo o tolerancia de la especificación correspondiente, producir una desviación técnica."@es .

edt:EvidenceBasedReasoner a edt:SoftwareAgent ;
    rdfs:label "razonador basado en evidencia"@es ;
    edt:description "Compara hechos, perfiles y secuencias mediante un método general; genera diagnósticos y explicaciones probables sin reglas causales específicas de los casos."@es .
edt:AcidityAdjustmentHeuristic a edt:ExpertHeuristic ;
    rdfs:label "heurística experta para acidez no deseada"@es ;
    dcterms:source "docs/transcripcion_barista_depurada.md"@es ;
    edt:description "Si una extracción presenta acidez no deseada, probar un ajuste pequeño de tiempo o de temperatura y evaluar sensorialmente la siguiente extracción; la prioridad depende del café y del contexto."@es .
edt:IterativeCalibrationProcedure a edt:CalibrationProcedure ;
    rdfs:label "procedimiento de calibración iterativa"@es ;
    dcterms:source "docs/transcripcion_barista_depurada.md"@es ;
    edt:description "Modificar un parámetro por prueba, realizar otra extracción y evaluar el resultado hasta obtener una bebida balanceada para el café y contexto utilizados."@es .
edt:UnderExtractionAcidityHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "conocimiento contextual: subextracción y acidez excesiva"@es ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC6668809/>,
        "docs/transcripcion_barista_depurada.md"@es ;
    edt:description "Cuando tiempo, TDS y rendimiento quedan por debajo del perfil y coinciden con acidez excesiva, la subextracción es el diagnóstico más probable; la interpretación es contextual y debe comprobarse mediante una nueva extracción controlada y evaluación sensorial."@es .
edt:HumanRecommendationValidationPolicy a edt:ValidationPolicy ;
    rdfs:label "política de validación humana de recomendaciones"@es ;
    dcterms:source "docs/transcripcion_barista_depurada.md"@es ;
    edt:description "Una recomendación se confirma mediante una nueva extracción y evaluación sensorial; no se autoriza autonomía inicial sin aprendizaje previo del comportamiento por café."@es .

# Reglas de la literatura y de los baristas (EKO 3.4.0, 2026-10-22). «Receta» es
# el perfil del barista con la tolerancia fijada por la dispersión de sus
# repeticiones; ninguna regla trae un umbral que no venga de su fuente. Las dos
# últimas quedan escritas pero el razonador no las aplica: con la canastilla
# presurizada no pueden activarse.

edt:BeverageMassFirstHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "primero la masa de bebida"@es ;
    dcterms:source "Pannusch et al. 2024, Journal of Food Engineering 367, 111887"@es ;
    skos:note "Confianza alta. La relación de preparación cambia significativamente el rendimiento y la composición."@es ;
    edt:description "Si la masa de bebida queda fuera de la receta, la diferencia de TDS o de sabor se atribuye primero a la proporción; las demás variables se juzgan después de repetir con la masa de la receta."@es .
edt:DoseConcentrationHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "dosis y concentración"@es ;
    dcterms:source "Andueza et al. 2007, Journal of the Science of Food and Agriculture 87, 586-592"@es ;
    skos:note "Confianza alta. Entre 6,5 y 8,5 g por 40 mL, los sólidos totales suben con la dosis y el rendimiento se mantiene o baja ligeramente (medido)."@es ;
    edt:description "Si la dosis queda fuera de la receta y el TDS se aparta en el mismo sentido con la masa de bebida dentro de la receta, la causa probable es la dosis y no la extracción: la bebida es más débil o más fuerte, no sub- ni sobreextraída."@es .
edt:HighDoseTasteHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "dosis alta y sabor"@es ;
    dcterms:source "Andueza et al. 2007, Journal of the Science of Food and Agriculture 87, 586-592"@es ;
    skos:note "Confianza media. Umbral de la fuente: un amargor mayor que 7,5 sobre 10 descarta la dosis; en arábica la señal fue más acidez y notas a quemado y acre (panel entrenado)."@es ;
    edt:description "Si la dosis queda por encima de la receta y la catación registra un amargor mayor que 7,5 sobre 10, o acidez excesiva o quemado, el exceso de café es el diagnóstico probable."@es .
edt:WithinDispersionHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "dentro de la dispersión de la receta"@es ;
    dcterms:source "Santanatoglia et al. 2023, Journal of Food Composition and Analysis 124, 105698"@es ;
    skos:note "Confianza alta. La fuente mide la variabilidad entre repeticiones en café filtrado; se toma el principio, no sus cifras."@es ;
    edt:description "Si dos extracciones con el mismo perfil difieren solo en valores que caben en la tolerancia de la receta, la diferencia no se atribuye a ninguna variable."@es .
edt:ColdWaterAcidityHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "agua fría y acidez"@es ;
    dcterms:source "support/transcripcion_barista_2026-10-13_depurada.md, 00:02:26 y 00:14:28"@es ;
    skos:note "Confianza media. El barista: «los dos graditos de diferencia siempre son importantes»; a 90 °C con receta de 92 °C, la acidez aumenta."@es ;
    edt:description "Si el agua estimada sobre el café queda al menos 2 °C por debajo del objetivo y la catación registra acidez excesiva, la temperatura baja es el diagnóstico probable."@es .
edt:LongBitterShotHeuristic a edt:ExpertHeuristic ;
    rdfs:label "café amargo y largo"@es ;
    dcterms:source "support/transcripcion_barista_2026-10-13_depurada.md, 00:16:49 y 00:16:57"@es ;
    skos:note "Confianza media. El barista: «primero vamos con tiempo»; después un grado de temperatura."@es ;
    edt:description "Si la catación registra amargor excesivo y el tiempo de extracción queda por encima de la receta, se acorta primero el tiempo; si no basta, se baja un grado la temperatura."@es .
edt:ShortShotHeuristic a edt:DiagnosticHeuristic ;
    rdfs:label "café cortado antes"@es ;
    dcterms:source "Waszkiewicz et al. 2026, arXiv:2512.21528"@es,
        <https://doi.org/10.1038/s41598-024-55831-x> ;
    skos:note "Confianza media. Las primeras gotas tienen cerca de 25 % de TDS y a los 60 s casi no traen sólidos (medido); el rendimiento sigue al tiempo de contacto."@es ;
    edt:description "Si el tiempo de extracción y la masa de bebida quedan por debajo de la receta, la bebida es más concentrada y con menos rendimiento por el tiempo de contacto."@es .

