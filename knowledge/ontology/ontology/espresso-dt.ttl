    edt:featureOfInterest edt:EnvironmentalConditionDemo ;
    edt:numericValue 58.0 ;
    edt:hasUnit edt:Percent ;
    edt:resultTime "2026-08-05T09:55:00-05:00"^^xsd:dateTime .

edt:TemperatureSeriesDemo a edt:ObservationSeries ;
