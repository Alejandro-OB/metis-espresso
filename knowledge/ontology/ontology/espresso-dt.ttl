edt:RuleBaristaCoffeeBedReview a owl:NamedIndividual ;
    owl:deprecated true .
edt:RuleBaristaIterativeCalibration a owl:NamedIndividual ;
    owl:deprecated true ; dcterms:isReplacedBy edt:IterativeCalibrationProcedure .
edt:RuleBaristaContextReview a owl:NamedIndividual ;
    owl:deprecated true .
edt:RuleHumidityCoffeeBedEffect a owl:NamedIndividual ;
    owl:deprecated true .
edt:RuleUnderExtractionAcidity a owl:NamedIndividual ;
    owl:deprecated true ; dcterms:isReplacedBy edt:UnderExtractionAcidityHeuristic .
edt:RuleBaristaHumanSupervision a owl:NamedIndividual ;
    owl:deprecated true ; dcterms:isReplacedBy edt:HumanRecommendationValidationPolicy .

edt:DeviationLongTimeDemo a edt:TechnicalDeviation ;
    rdfs:label "tiempo superior al objetivo del perfil"@es ;
    edt:derivedFrom edt:ObsTimeDemo, edt:SpecTimeDemo ;
    edt:basedOnCriterion edt:ProfileConformanceCriterion ;
    edt:statusCode "above-profile" .
edt:ActionShorterTimeDemo a edt:RecommendedAction ;
    rdfs:label "evaluar un tiempo de extracción más corto"@es ;
    edt:respondsTo edt:DeviationLongTimeDemo ;
    edt:derivedFrom edt:DeviationLongTimeDemo ;
    edt:followsProcedure edt:IterativeCalibrationProcedure ;
    edt:governedByPolicy edt:HumanRecommendationValidationPolicy ;
    edt:generatedBy edt:EvidenceBasedReasoner ;
    edt:adjustsProperty edt:ExtractionTime ;
    edt:recommendedDirection edt:Decrease ;
    edt:hasValidationStatus edt:Accepted ;
    edt:validatedBy edt:BaristaDemo ;
    edt:validationTime "2026-08-05T10:02:05-05:00"^^xsd:dateTime ;
    edt:validationRationale "El barista autoriza una prueba controlada con un tiempo de extracción más corto y exige comprobar el resultado en una nueva extracción."@es ;
    edt:description "Recomendación sintética que debe ser confirmada por un barista antes de ejecutarse."@es .

edt:MachineLocalProfileDemo a edt:LocalKnowledgeProfile ; edt:assertsKnowledge edt:MachineStaticContextDemo, edt:ExtractionDynamicContextDemo, edt:DeviationLongTimeDemo .
edt:GlobalProfileDemo a edt:GlobalKnowledgeProfile ;
    edt:assertsKnowledge edt:DeviationLongTimeDemo, edt:ActionShorterTimeDemo,
        edt:AcidityAdjustmentHeuristic, edt:IterativeCalibrationProcedure,
        edt:HumanRecommendationValidationPolicy .
edt:MachineStaticContextDemo a edt:StaticContextAssertion ; edt:textValue "MachineDemo configurada para ProfileDemo01" .
edt:ExtractionDynamicContextDemo a edt:DynamicContextAssertion ; edt:textValue "ExtractionDemo01 en estado completado" .

# Caso sintético de calibración y contexto ambiental.

edt:EnvironmentalConditionDemo a edt:EnvironmentalCondition ;
