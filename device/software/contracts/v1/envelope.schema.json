{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eko.local/contracts/v1/envelope.schema.json",
  "title": "EKO message envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "deviceId", "sequence", "occurredAt", "payload"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "messageId": {"type": "string", "minLength": 8, "maxLength": 80},
    "messageType": {"enum": ["telemetry.sample", "operational.event", "extraction.completed", "extraction.series", "profile.proposal"]},
    "deviceId": {"type": "string", "minLength": 1, "maxLength": 80},
    "sequence": {"type": "integer", "minimum": 0},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}

