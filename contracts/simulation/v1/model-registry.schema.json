{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eko.local/contracts/simulation/v1/model-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "modelVersion",
        "displayName",
        "purpose",
        "role",
        "status",
        "artifact",
        "contract",
        "source",
        "capabilities"
      ],
      "properties": {
        "modelId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "modelVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "purpose": {
          "const": "espresso-process-simulation"
        },
        "role": {
          "enum": [
            "canonical",
            "candidate",
            "superseded",
            "fixture"
          ],
          "description": "canonical: la que corre la plataforma sin pedir otra; candidate: registrada, a la espera de aprobación; superseded: sustituida, se conserva para reproducir lo que se hizo con ella"
        },
        "status": {
          "enum": [
            "draft",
            "pending-approval",
            "approved-for-simulation",
            "retired"
          ]
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "mediaType"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "mediaType": {
              "const": "application/x-fmu"
            }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "enum": [
                "1.0",
                "2.0"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "modelicaClass",
            "exportTool"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "modelicaClass": {
              "type": "string",
              "minLength": 1
            },
            "exportTool": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "communicationStepSeconds",
            "channels"
          ],
          "properties": {
            "communicationStepSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "channels": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/channel"
              }
            },
            "replicaParameters": {
              "type": "object",
              "description": "Parámetros que la réplica de una preparación fija desde lo que la preparación declara",
              "properties": {
                "portafilterConfiguration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "parameter",
                    "values",
                    "modelDefault"
                  ],
                  "properties": {
                    "parameter": {
                      "type": "string"
                    },
                    "values": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "modelDefault": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "artifactsByArchitecture": {
          "type": "object",
          "description": "Un artefacto por arquitectura (ADR-011 § 4.2); la plataforma corre el de su máquina",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "mediaType"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "mediaType": {
                "const": "application/x-fmu"
              },
              "recompiledFrom": {
                "$ref": "#/$defs/sha256",
                "description": "sha256 del artefacto del que se recompiló"
              },
              "provenance": {
                "type": "string"
              },
              "equivalence": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quantity",
        "unit",
        "origin",
        "maturity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quantity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "origin": {
          "const": "simulated"
        },
        "maturity": {
          "enum": [
            "stable",
            "experimental",
            "diagnostic"
          ]
        }
      }
    }
  }
}
